#!/bin/bash
# Pre-push hook: run the full test suite before pushing.
# If tests fail, the push is blocked.
#
# Install:  git config core.hooksPath .githooks
# Skip:     git push --no-verify  (or  git push -o no-verify)

set -e

echo "=== pre-push: running full test suite ==="

if ! uv run python -m pytest tests/ --ignore=tests/e2e -q --tb=no; then
    echo ""
    echo "--- pre-push ABORTED: test failures detected ---"
    echo "  Fix the failures, then push again."
    echo "  To skip: git push --no-verify"
    exit 1
fi

echo "=== pre-push: all tests passed ==="