    {
      "prefix": "remove_overlays",
      "type": "boolean_toggle",
      "accordion": "overlays",
      "media_types": [
        "movie",
        "show"
      ],
      "title": "Remove Overlays",
      "wiki": "https://kometa.wiki/en/nightly/config/libraries/#remove-overlays",
      "description": "Remove Overlays will remove all overlays from your library. This toggle will take priority over any previous selections.",
      "tooltip_variant": "info",
      "container_class": ""
    },
    {
      "prefix": "reset_overlays",
      "type": "select",
      "accordion": "overlays",
      "media_types": [
        "movie",
        "show"
      ],
      "title": "Reset Overlays",
      "wiki": "https://kometa.wiki/en/nightly/config/libraries/#reset-overlays",
      "description": "Reset Overlays will grab a new base image from the source that you choose, and then use that as the source for applying your overlays.<br><br><b>Warning:</b> Once you have done a run with Reset Overlays, you should then set this value to None or remove the reset_overlays line(s) from your config.yml. If you do not do this, you will end up in a loop of your overlays being removed, a new image grabbed, and your overlays reapplying.",
      "tooltip_variant": "danger",
      "container_class": "",
      "options": [
        [
          "",
          "None"
        ],
        [
          "tmdb",
          "TMDb"
        ],
        [
          "plex",
          "Plex"
        ]
      ]
    },
    {
      "prefix": "assets_for_all",
      "type": "boolean_toggle",
      "accordion": "library",
      "media_types": [
        "movie",
        "show"
      ],
      "title": "Assets for All",
      "wiki": "https://kometa.wiki/en/nightly/config/operations/#assets-for-all",
      "description": "Searches asset directories for images for all items in the library.",
      "tooltip_variant": "info"
    },
    {
      "prefix": "delete_collections",
      "type": "toggle_with_number",
      "accordion": "library",
      "media_types": ["movie", "show"],
      "title": "Delete Collections",
      "wiki": "https://kometa.wiki/en/nightly/config/operations/#delete-collections",
      "description": "Deletes collections based on a set of given attributes. The Collection must match all set attributes to be deleted.",
      "tooltip_variant": "info",
      "container_class": "border rounded p-3 mb-2",
      "toggles": [
        {
          "key": "delete_collections_managed",
          "label": "Managed Collections",
          "tooltip": "When enabled: Only collections <strong>with the <code>Kometa</code> label</strong> (Managed) will be deleted."
        },
        {
          "key": "delete_collections_configured",
          "label": "Configured Collections",
          "tooltip": "When enabled: Only collections <strong>defined in the current config file</strong> will be eligible for deletion."
        },
        {
          "key": "ignore_empty_smart_collections",
          "label": "Ignore Empty Smart Collections",
          "tooltip": "When enabled: Excludes empty smart collections from being affected by the <code>less</code> item count check. This allows retaining things like smart collections that show movies without subtitles or the like."
        }
      ],
      "number_input": {
        "key": "delete_collections_less",
        "label": "Less Than (item count)",
        "tooltip": "Only collections with <strong>fewer than this number of items</strong> will be deleted. Optional value which if undefined means collections will be deleted regardless of how many items they have.",
        "min": 1
      }
    },
    {
      "prefix": "mass_genre_update",
      "type": "mass_update",
      "accordion": "library",
      "media_types": [
        "movie",
        "show"
      ],
      "title": "Mass Genre Update",
      "wiki": "https://kometa.wiki/en/nightly/config/operations/#mass-genre-update",
      "description": "Updates every item's genres using selected sources or strings.",
      "tooltip_variant": "info",
      "container_class": "border rounded p-3 mb-2",
      "has_custom_string": true,
      "custom_string_placeholder": "Enter custom genre (e.g. Thriller)",
      "custom_string_behavior": "list",
      "sources": [
        ["tmdb", "Use TMDb for Genres", "Fetch genres from <b>TMDb</b>. Recommended for most media types."],
        ["tvdb", "Use TVDb for Genres", "Fetch genres from <b>TVDb</b>. Alternative for TV content."],
        ["imdb", "Use IMDb for Genres", "Fetch genres directly from <b>IMDb</b>."],
        ["omdb", "Use IMDb through OMDb for Genres", "Fetch genres via <b>OMDb API</b> (IMDb-backed)."],
        ["anidb", "Use AniDB Main Tags for Genres", "Use only <b>Main Tags</b> from AniDB."],
        ["anidb_3_0", "AniDB Main Tags & 3★+", "AniDB Main Tags and all <b>3-star and higher</b> tags."],
        ["anidb_2_5", "AniDB Main Tags & 2.5★+", "AniDB Main Tags and all <b>2.5-star and higher</b> tags."],
        ["anidb_2_0", "AniDB Main Tags & 2★+", "AniDB Main Tags and all <b>2-star and higher</b> tags."],
        ["anidb_1_5", "AniDB Main Tags & 1.5★+", "AniDB Main Tags and all <b>1.5-star and higher</b> tags."],
        ["anidb_1_0", "AniDB Main Tags & 1★+", "AniDB Main Tags and all <b>1-star and higher</b> tags."],
        ["anidb_0_5", "AniDB Main Tags & 0.5★+", "AniDB Main Tags and all <b>0.5-star and higher</b> tags."],
        ["mal", "Use MyAnimeList for Genres", "Fetch genres from <b>MyAnimeList</b> (MAL)."],
        ["lock", "Lock all Genre Field", "Prevent genre field from being modified after this operation."],
        ["unlock", "Unlock all Genre Field", "Allow genre field to be modified after this operation."],
        ["remove", "Remove all Genres and Lock all Field", "Clear all genres and <b>lock</b> the field."],
        ["reset", "Remove all Genres and Unlock all Field", "Clear all genres and <b>unlock</b> the field."]
      ]
    },
